generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MEMBER
}
enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}
enum TopicDifficulty {
  EASY
  MEDIUM
  HARD
}
enum TopicPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id           String            @id @default(cuid())
  name         String
  email        String            @unique
  passwordHash String
  avatar       String?
  timeZone     String            @default("Asia/Kolkata")
  createdAt    DateTime          @default(now())
  memberships  WorkspaceMember[]
  plans        StudyPlan[]
  sessions     StudySession[]
  streak       StudyStreak?
}

model Workspace {
  id        String            @id @default(cuid())
  name      String
  inviteCode String           @unique @default(cuid())
  createdAt DateTime          @default(now())
  members   WorkspaceMember[]
  plans     StudyPlan[]
}

model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model StudyPlan {
  id          String     @id @default(cuid())
  workspaceId String
  ownerId     String
  name        String
  description String?
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categories  Category[]
  topics      Topic[]

  @@unique([id, ownerId])
  @@index([workspaceId, ownerId])
}

model Category {
  id          String    @id @default(cuid())
  studyPlanId String
  name        String
  description String?
  icon        String?
  color       String?
  order       Int       @default(0)
  studyPlan   StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([studyPlanId, name])
  @@unique([id, studyPlanId])
}

model Topic {
  id             String          @id @default(cuid())
  categoryId     String?
  studyPlanId    String
  ownerId        String
  title          String
  description    String?
  dayNumber      Int?
  order          Int             @default(0)
  difficulty     TopicDifficulty @default(MEDIUM)
  priority       TopicPriority   @default(MEDIUM)
  estimatedHours Float?
  status         TopicStatus     @default(NOT_STARTED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       Category?       @relation(fields: [categoryId, studyPlanId], references: [id, studyPlanId], onDelete: Cascade)
  studyPlan      StudyPlan       @relation(fields: [studyPlanId, ownerId], references: [id, ownerId], onDelete: Cascade)
  sessions       StudySession[]

  @@index([studyPlanId, ownerId, dayNumber, order])
}

model StudySession {
  id              String   @id @default(cuid())
  userId          String
  topicId         String
  date            DateTime @default(now())
  durationMinutes Int
  notes           String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([topicId, date])
}

model StudyStreak {
  userId        String   @id
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastStudyDate DateTime?
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
